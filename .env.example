# Dry-run is ON by default. The public portfolio version prepares
# CSV reports and draft templates; sending is disabled unless you
# both set DRY_RUN=false here AND pass --send on the CLI.
DRY_RUN=true

# SMTP credentials are required ONLY if you intend to actually send.
# Leave blank for dry-run.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Path to the candidate profile YAML.
PROFILE_PATH=profile.yaml
